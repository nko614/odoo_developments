<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nfl_game_view_list" model="ir.ui.view">
        <field name="name">nfl.game.list</field>
        <field name="model">nfl.game</field>
        <field name="arch" type="xml">
            <list string="Games" create="0" decoration-muted="status == 'final'" decoration-danger="status == 'in_progress'">
                <header>
                    <button name="action_sync_all" type="object" string="Sync from ESPN" class="btn-primary" display="always"/>
                </header>
                <field name="kickoff" string="Date / Time"/>
                <field name="week"/>
                <field name="season_type" optional="hide"/>
                <field name="away_team_id"/>
                <field name="home_team_id"/>
                <field name="score"/>
                <field name="venue"/>
                <field name="location"/>
                <field name="broadcast"/>
                <field name="status" widget="badge" decoration-success="status == 'final'" decoration-danger="status == 'in_progress'" decoration-info="status == 'scheduled'"/>
                <field name="status_detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="nfl_game_view_form" model="ir.ui.view">
        <field name="name">nfl.game.form</field>
        <field name="model">nfl.game</field>
        <field name="arch" type="xml">
            <form string="Game" create="0">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="scheduled,in_progress,final"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3 invisible="not score"><field name="score" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="When">
                            <field name="kickoff" string="Kickoff"/>
                            <field name="season"/>
                            <field name="season_type"/>
                            <field name="week"/>
                            <field name="status_detail"/>
                        </group>
                        <group string="Where">
                            <field name="venue"/>
                            <field name="location"/>
                            <field name="neutral_site"/>
                            <field name="broadcast"/>
                        </group>
                        <group string="Teams">
                            <field name="away_team_id"/>
                            <field name="away_score"/>
                            <field name="home_team_id"/>
                            <field name="home_score"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nfl_game_view_calendar" model="ir.ui.view">
        <field name="name">nfl.game.calendar</field>
        <field name="model">nfl.game</field>
        <field name="arch" type="xml">
            <calendar string="Games" date_start="kickoff" date_stop="kickoff_end" mode="month" color="home_team_id" create="0" quick_create="0" event_limit="8">
                <field name="venue"/>
                <field name="location"/>
                <field name="broadcast"/>
                <field name="score"/>
            </calendar>
        </field>
    </record>

    <record id="nfl_game_view_search" model="ir.ui.view">
        <field name="name">nfl.game.search</field>
        <field name="model">nfl.game</field>
        <field name="arch" type="xml">
            <search string="Games">
                <field name="name"/>
                <field name="home_team_id" string="Team" filter_domain="['|', ('home_team_id', 'ilike', self), ('away_team_id', 'ilike', self)]"/>
                <field name="venue"/>
                <field name="city"/>
                <field name="week"/>
                <filter name="upcoming" string="Upcoming" domain="[('status', 'in', ('scheduled', 'in_progress'))]"/>
                <filter name="final" string="Final" domain="[('status', '=', 'final')]"/>
                <separator/>
                <filter name="regular" string="Regular Season" domain="[('season_type', '=', '2')]"/>
                <filter name="postseason" string="Postseason" domain="[('season_type', '=', '3')]"/>
                <filter name="neutral" string="Neutral Site / International" domain="[('neutral_site', '=', True)]"/>
                <group>
                    <filter name="group_week" string="Week" context="{'group_by': 'week'}"/>
                    <filter name="group_home" string="Home Team" context="{'group_by': 'home_team_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="nfl_game_action" model="ir.actions.act_window">
        <field name="name">Schedule</field>
        <field name="res_model">nfl.game</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No games yet</p>
            <p>Click <b>Sync from ESPN</b> to pull the NFL schedule.</p>
        </field>
    </record>
</odoo>
