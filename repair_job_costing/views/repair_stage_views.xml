<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_stage_view_list" model="ir.ui.view">
        <field name="name">repair.stage.view.list</field>
        <field name="model">repair.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="repair_stage_action" model="ir.actions.act_window">
        <field name="name">Repair Stages</field>
        <field name="res_model">repair.stage</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="repair_stage_menu" name="Stages" parent="repair.repair_menu_config" action="repair_stage_action" sequence="5"/>
</odoo>
