<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fitness_connection_view_list" model="ir.ui.view">
        <field name="name">fitness.connection.list</field>
        <field name="model">fitness.connection</field>
        <field name="arch" type="xml">
            <list string="Connections" create="0" delete="0"
                  decoration-success="state == 'connected'" decoration-danger="state == 'reconnect'" decoration-muted="state == 'disconnected'">
                <field name="provider"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-danger="state == 'reconnect'"/>
                <field name="athlete_name"/>
                <field name="last_sync"/>
                <field name="last_message"/>
                <field name="expires_at" optional="hide"/>
                <field name="last_error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="fitness_connection_view_form" model="ir.ui.view">
        <field name="name">fitness.connection.form</field>
        <field name="model">fitness.connection</field>
        <field name="arch" type="xml">
            <form string="Connection" create="0" delete="0" edit="0">
                <header>
                    <button name="action_connect" type="object" string="Connect" class="btn-primary" icon="link" invisible="state == 'connected'"/>
                    <button name="action_sync" type="object" string="Sync Now" class="btn-primary" icon="refresh" invisible="state != 'connected'"/>
                    <button name="action_connect" type="object" string="Reconnect" icon="link" invisible="state != 'connected'"/>
                    <button name="action_disconnect" type="object" string="Disconnect" icon="link_off" invisible="state == 'disconnected'"
                            confirm="Disconnect? Synced data is kept; you can reconnect any time."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="status" invisible="not last_message or last_error">
                        <field name="last_message"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="provider"/></h1>
                        <h4><field name="status_display"/></h4>
                    </div>
                    <group>
                        <group string="Account">
                            <field name="athlete_name"/>
                            <field name="athlete_id"/>
                            <field name="profile_info" invisible="not profile_info"/>
                            <field name="scope"/>
                        </group>
                        <group string="Sync">
                            <field name="last_sync"/>
                            <field name="expires_at"/>
                            <field name="redirect_uri" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fitness_connection_action" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">fitness.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No connections yet</p>
            <p>Go to <b>Configuration &gt; Settings</b>, enter your API keys and click <b>Connect</b>.</p>
        </field>
    </record>
</odoo>
