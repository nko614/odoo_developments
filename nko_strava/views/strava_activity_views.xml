<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="strava_activity_view_list" model="ir.ui.view">
        <field name="name">strava.activity.list</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <list string="Activities" create="0"
                  decoration-success="sport_group == 'run'"
                  decoration-info="sport_group == 'ride'"
                  decoration-warning="sport_group == 'walk'"
                  decoration-primary="sport_group == 'swim'"
                  decoration-muted="is_sample">
                <header>
                    <button name="action_sync_all" type="object" string="Sync Now" class="btn-primary" display="always" icon="refresh"/>
                </header>
                <field name="sport_group" column_invisible="1"/>
                <field name="is_sample" column_invisible="1"/>
                <field name="start_date" string="Start" widget="datetime"/>
                <field name="name"/>
                <field name="sport_type" string="Sport"/>
                <field name="distance_mi" sum="Total miles"/>
                <field name="moving_time_display" string="Moving Time"/>
                <field name="pace_display"/>
                <field name="elevation_ft" sum="Total feet"/>
                <field name="average_heartrate" optional="show"/>
                <field name="suffer_score" optional="hide"/>
                <field name="calories" optional="hide"/>
                <field name="kudos_count" optional="hide"/>
                <field name="pr_count" optional="hide"/>
                <field name="gear_name" optional="hide"/>
                <field name="has_route" optional="hide"/>
                <field name="moving_hours" optional="hide" sum="Total hours"/>
            </list>
        </field>
    </record>

    <record id="strava_activity_view_form" model="ir.ui.view">
        <field name="name">strava.activity.form</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <form string="Activity" create="0">
                <header>
                    <button name="action_open_strava" type="object" string="View on Strava" icon="open_in_new" invisible="not strava_url"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="badge text-bg-warning" invisible="not is_sample">Sample data</span>
                        <h1><field name="name"/></h1>
                        <h4 class="text-muted"><field name="sport_type" readonly="1" class="oe_inline"/> · <field name="start_date_local" readonly="1" class="oe_inline"/></h4>
                    </div>
                    <div class="o_nko_strava_stats d-flex flex-wrap gap-4 my-3">
                        <div><div class="text-muted small">Distance</div><div class="fs-3"><field name="distance_mi" readonly="1" class="oe_inline"/> mi</div></div>
                        <div><div class="text-muted small">Moving Time</div><div class="fs-3"><field name="moving_time_display" readonly="1"/></div></div>
                        <div><div class="text-muted small">Pace / Speed</div><div class="fs-3"><field name="pace_display" readonly="1"/></div></div>
                        <div><div class="text-muted small">Elevation</div><div class="fs-3"><field name="elevation_ft" readonly="1" class="oe_inline"/> ft</div></div>
                        <div invisible="not average_heartrate"><div class="text-muted small">Avg HR</div><div class="fs-3"><field name="average_heartrate" readonly="1" class="oe_inline"/> bpm</div></div>
                    </div>
                    <field name="summary_polyline" widget="strava_route_map" nolabel="1" readonly="1" class="w-100"/>
                    <group>
                        <group string="Time">
                            <field name="start_date" readonly="1"/>
                            <field name="timezone" readonly="1"/>
                            <field name="moving_time_display" readonly="1"/>
                            <field name="elapsed_time_display" readonly="1"/>
                            <field name="activity_date" readonly="1"/>
                        </group>
                        <group string="Effort">
                            <field name="average_heartrate" readonly="1"/>
                            <field name="max_heartrate" readonly="1"/>
                            <field name="average_watts" readonly="1" invisible="not average_watts"/>
                            <field name="kilojoules" readonly="1" invisible="not kilojoules"/>
                            <field name="calories" readonly="1"/>
                            <field name="suffer_score" readonly="1"/>
                        </group>
                        <group string="Speed">
                            <field name="avg_mph" readonly="1"/>
                            <field name="max_mph" readonly="1"/>
                        </group>
                        <group string="Social &amp; Gear">
                            <field name="kudos_count" readonly="1"/>
                            <field name="achievement_count" readonly="1"/>
                            <field name="pr_count" readonly="1"/>
                            <field name="gear_name" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="trainer" readonly="1"/>
                            <field name="commute" readonly="1"/>
                            <field name="private" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Raw (metric)" name="raw">
                            <group>
                                <group>
                                    <field name="strava_id"/>
                                    <field name="strava_url" widget="url" invisible="not strava_url"/>
                                    <field name="distance" readonly="1"/>
                                    <field name="total_elevation_gain" readonly="1"/>
                                    <field name="moving_time" readonly="1"/>
                                    <field name="elapsed_time" readonly="1"/>
                                </group>
                                <group>
                                    <field name="average_speed" readonly="1"/>
                                    <field name="max_speed" readonly="1"/>
                                    <field name="start_lat" readonly="1"/>
                                    <field name="start_lng" readonly="1"/>
                                    <field name="details_fetched"/>
                                    <field name="is_sample"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="strava_activity_view_calendar" model="ir.ui.view">
        <field name="name">strava.activity.calendar</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <calendar string="Activities" date_start="start_date" date_stop="end_date" mode="month" color="sport_group" create="0" quick_create="0" event_limit="5">
                <field name="sport_type"/>
                <field name="distance_mi"/>
                <field name="moving_time_display"/>
                <field name="pace_display"/>
            </calendar>
        </field>
    </record>

    <record id="strava_activity_view_graph" model="ir.ui.view">
        <field name="name">strava.activity.graph</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <graph string="Miles by Month" type="bar" stacked="1">
                <field name="activity_date" interval="month"/>
                <field name="sport_group"/>
                <field name="distance_mi" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="strava_activity_view_pivot" model="ir.ui.view">
        <field name="name">strava.activity.pivot</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <pivot string="Activity Analysis">
                <field name="activity_date" interval="month" type="row"/>
                <field name="sport_group" type="col"/>
                <field name="distance_mi" type="measure"/>
                <field name="moving_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="strava_activity_view_search" model="ir.ui.view">
        <field name="name">strava.activity.search</field>
        <field name="model">strava.activity</field>
        <field name="arch" type="xml">
            <search string="Activities">
                <field name="name"/>
                <field name="sport_type"/>
                <field name="gear_name"/>
                <field name="description"/>
                <filter name="run" string="Run" domain="[('sport_group', '=', 'run')]"/>
                <filter name="ride" string="Ride" domain="[('sport_group', '=', 'ride')]"/>
                <filter name="walk" string="Walk / Hike" domain="[('sport_group', '=', 'walk')]"/>
                <filter name="swim" string="Swim" domain="[('sport_group', '=', 'swim')]"/>
                <separator/>
                <filter name="this_week" string="This Week" domain="[('activity_date', '&gt;=', 'today =week_start')]"/>
                <filter name="this_month" string="This Month" domain="[('activity_date', '&gt;=', 'today =1d')]"/>
                <filter name="this_year" string="This Year" domain="[('activity_date', '&gt;=', 'today =1m =1d')]"/>
                <filter name="filter_activity_date" string="Date" date="activity_date"/>
                <separator/>
                <filter name="with_route" string="Has Route" domain="[('has_route', '=', True)]"/>
                <filter name="indoor" string="Indoor / Trainer" domain="[('trainer', '=', True)]"/>
                <filter name="commute" string="Commute" domain="[('commute', '=', True)]"/>
                <filter name="sample" string="Sample Data" domain="[('is_sample', '=', True)]"/>
                <group>
                    <filter name="group_sport" string="Sport" context="{'group_by': 'sport_group'}"/>
                    <filter name="group_sport_type" string="Sport Type" context="{'group_by': 'sport_type'}"/>
                    <filter name="group_year" string="Year" context="{'group_by': 'activity_date:year'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'activity_date:month'}"/>
                    <filter name="group_gear" string="Gear" context="{'group_by': 'gear_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="strava_activity_action" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">strava.activity</field>
        <field name="view_mode">list,calendar,graph,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activities yet</p>
            <p>Connect Strava in <b>Configuration &gt; Settings</b>, then click <b>Sync Now</b>.</p>
        </field>
    </record>

    <record id="strava_activity_stats_action" model="ir.actions.act_window">
        <field name="name">Stats</field>
        <field name="res_model">strava.activity</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No activities yet</p>
        </field>
    </record>

    <record id="strava_activity_map_action" model="ir.actions.client">
        <field name="name">Map</field>
        <field name="tag">nko_strava.activity_map</field>
    </record>
</odoo>
